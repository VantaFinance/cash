  "components": {
    "schemas": {
      "CreateApplication": {
        "type": "object",
        "required": [
          "antifraudProviders",
          "redirectUrls"
        ],
        "properties": {
          "antifraudProviders": {
            "type": "array",
            "description": "Провайдеры антифрода",
            "examples": [
              [
                {"provider":  "JUICY_SCORE", "sessionId":  "123"}
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/AntifraudProvider"
            }
          },
          "redirectUrls": {
            "type": "array",
            "description": "Список URL-адресов для перенаправления клиента. При достижении определенного этапа процесса МФО выполняет редирект клиента на соответствующий адрес.",
            "examples": [
              [
                {"type":  "AUTHORIZE_STARTED", "url":  "https://vanta.ru?sessionId=801ada51-cc07-46cb-b700-1371abf70e02"}
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/RedirectUrl"
            }
          }
        }
      },
      "RedirectUrl": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Тип событий, при котором необходимо выполнить перенаправление клиента: \n\n- `AUTHORIZE_STARTED` - Успешно запустилась авторизация займа \n\n- `AUTHORIZED_REJECTED` - МФО отказался в авторизации займа  \n\n-  `AUTHORIZED_CANCELLED` - Клиент отказался в авторизации займа",
            "enum": [
              "AUTHORIZE_STARTED",
              "AUTHORIZED_REJECTED",
              "AUTHORIZED_CANCELLED"
            ],
            "url": {
              "type": "string",
              "format": "uri",
              "description": "URL-адрес, на который необходимо перенаправить клиента."
            }
          }
        }
      },
      "AntifraudProvider": {
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/AntifraudProviderType"
          }
        },
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "JUICY_SCORE": "#/components/schemas/JuciScoreAntifraudProvider"
          }
        },
        "type": "object"
      },
      "JuciScoreAntifraudProvider": {
        "required": [
          "type",
          "sessionId"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/AntifraudProvider"
          },
          {
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Id сессии"
              }
            }
          }
        ]
      },
      "AntifraudProviderType": {
        "type": "string",
        "description": "Типы провайдеров антифрода: \n\n- `JUICY_SCORE` - JuicyScore  \n\n",
        "enum": [
          "JUICY_SCORE"
        ]
      },
      "ApplicationId": {
        "description": "Идентификатор заявки",
        "type": "string",
        "examples": [
          "00000000-0000-0000-0000-000000000000"
        ]
      },
      "LoanAgreement": {
        "type": "object",
        "description": "Параметры договора займа",
        "required": [
          "agreementNumber",
          "monthlyPayment",
          "term",
          "totalCost",
          "rate",
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Одобренная сумма займа <span style=\"color:red\">**копейках**</span>",
            "examples": [
              "500000"
            ]
          },
          "agreementNumber": {
            "type": "string",
            "description": "Номер договора займа",
            "examples": [
              "DNS7023227"
            ]
          },
          "monthlyPayment": {
            "type": "string",
            "description": "Ежемесячный платеж <span style=\"color:red\">**копейках**</span>",
            "examples": [
              "500000"
            ]
          },
          "term": {
            "type": "integer",
            "description": "Срок займа в месяцах",
            "minimum": 1
          },
          "totalCost": {
            "description": "Полная стоимость займа",
            "required": [
              "percent",
              "amount"
            ],
            "type": "object",
            "properties": {
              "percent": {
                "type": "string",
                "description": "Полная стоимость займа в процентах",
                "format": "float",
                "examples": [
                  "10"
                ]
              },
              "amount": {
                "type": "string",
                "description": "Полная стоимость займа <span style=\"color:red\">**копейках**</span>",
                "format": "int64",
                "examples": [
                  "200"
                ]
              }
            }
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Процентная ставка по займу (годовых, в %)",
            "minimum": 0,
            "maximum": 100,
            "example": 18.5
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "https://tools.ietf.org/html/rfc2616#section-10"
            ]
          },
          "title": {
            "type": "string",
            "examples": [
              "$title"
            ]
          },
          "status": {
            "type": "integer",
            "examples": [
              0
            ]
          },
          "detail": {
            "type": "string",
            "examples": [
              "$detail"
            ]
          }
        },
        "type": "object"
      }
    }
  }
}