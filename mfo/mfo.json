{
  "openapi": "3.1.0",
  "info": {
    "title": "Abstract MFO",
    "description": {
      "$ref": "./mfo.md"
    },
    "version": "0.1"
  },
  "webhooks": {
    "onAuthorizationLoanAgreement": {
      "post": {
        "tags": [
          "События договора займа"
        ],
        "summary": "Событие авторизации договора займа",
        "description": "Данное событие срабатывает при запуски бизнес процесса: `Авторизация договора займа`.",
        "requestBody": {
          "required": true,
          "description": "Body request",
          "content": {
            "application/json": {
              "schema": {
                "required": ["applicationId", "type", "message", "status"],
                "properties": {
                  "applicationId": {
                    "$ref": "#/components/schemas/ApplicationId"
                  },
                  "type": {
                    "type": "string",
                    "description": "Тип события",
                    "examples": [
                      "AuthorizationLoanAgreement"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "description": "Статус авторизации договора займа. \n- `AUTHORIZED` - Договор успешно авторизирован \n- `ERROR` - Договор не авторизирован \n- `REJECTED` - Банк отказался авторизовать договор  \n- `CANCELLED` - Клиент отказался от займа`",
                    "enum": [
                      "AUTHORIZED",
                      "ERROR",
                      "REJECTED"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "description": "Сообщение об состоянии",
                    "examples": [
                      "Договора займа успешно авторизирован"
                    ]
                  }
                },
                "type": "object"
              }
            }
          }
        }
      }
    },
    "onAuthorizeLoanAgreementStarted": {
      "post": {
        "tags": [
          "События договора займа"
        ],
        "summary": "Событие старта авторизации займа",
        "description": "Данное событие срабатывает при запуски бизнес процесса: `Авторизация договора займа`.",
        "requestBody": {
          "required": true,
          "description": "Body request",
          "content": {
            "application/json": {
              "schema": {
                "required": ["applicationId", "type", "coolingFrom", "coolingTo"],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Тип события",
                    "examples": [
                      "AuthorizeLoanAgreementStarted"
                    ]
                  },
                  "applicationId": {
                    "$ref": "#/components/schemas/ApplicationId"
                  }
                },
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/application": {
      "post": {
        "tags": [
          "Операции над заявкой"
        ],
        "description": "Создать заявку на займ",
        "summary": "Создать заявку на займ",
        "requestBody": {
          "description": "Body request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplication"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешно создана заявка",
            "content": {
              "application/json": {
                "schema": {
                  "required": ["id"],
                  "description": "Успешно создана заявка",
                  "properties": {
                    "id": {
                      "$ref": "#/components/schemas/ApplicationId"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Плохой запрос/Бизнес исключение",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Недостаточно прав доступа",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизированны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка приложения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/application/{id}": {
      "get": {
        "tags": [
          "Операции над заявкой"
        ],
        "description": "Получить заявку",
        "summary": "Получить заявку",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ApplicationId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Получена заявка",
            "content": {
              "application/json": {
                "schema": {
                  "required": ["id", "status"],
                  "description": "Получена заявка",
                  "properties": {
                    "id": {
                      "$ref": "#/components/schemas/ApplicationId"
                    },
                    "status": {
                      "type": "string",
                      "description": "Статус заявки.\n\n Возможные значения: \n\n **Скоринг** \n\n- `SCORING_PENDING` - Ожидание результата скоринга\n\n- `SCORING_FAILED` - Ошибка при скоринге\n\n- `SCORING_APPROVED` - Скоринг одобрен\n\n- `SCORING_REJECTED` - Скоринг отклонён\n\n **Черновик договора** \n\n- `CONTRACT_DRAFT_PENDING` - Ожидание черновика договора\n\n- `CONTRACT_DRAFT_REJECTED` - Отказано в обслуживании\n\n- `CONTRACT_DRAFT_FAILED` - Ошибка при создании черновика\n\n- `CONTRACT_DRAFT_RECEIVED` - Черновик договора получен\n\n **Договор** \n\n- `SIGN_PENDING` - Ожидание подписания\n\n- `SIGN_FAILED` - Ошибка при подписании\n\n- `SIGN_REJECTED` - Подписание отклонено\n\n- `SIGNED` - Договор подписан\n\n **Авторизация договора** \n\n- `AUTHORIZED` - Договор авторизован\n\n- `AUTHORIZED_FAILED` - Ошибка авторизации\n\n- `AUTHORIZE_PENDING` - Ожидание авторизации\n\n- `AUTHORIZED_CANCELLED` - Авторизация отменена\n\n- `AUTHORIZED_REJECTED` - Авторизация отклонена",
                      "enum": [
                        "SCORING_PENDING",
                        "SCORING_FAILED",
                        "SCORING_APPROVED",
                        "SCORING_REJECTED",
                        "CONTRACT_DRAFT_PENDING",
                        "CONTRACT_DRAFT_FAILED",
                        "CONTRACT_DRAFT_RECEIVED",
                        "CONTRACT_DRAFT_REJECTED",
                        "SIGN_PENDING",
                        "SIGN_FAILED",
                        "SIGN_REJECTED",
                        "SIGNED",
                        "AUTHORIZED",
                        "AUTHORIZED_FAILED",
                        "AUTHORIZE_PENDING",
                        "AUTHORIZED_CANCELLED",
                        "AUTHORIZED_REJECTED"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Плохой запрос/Бизнес исключение",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Недостаточно прав доступа",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизированны",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка приложения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
